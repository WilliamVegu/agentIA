digraph lifecycle {
  rankdir=LR; fontname="Helvetica"; newrank=true;
  graph [nodesep=0.28, ranksep=0.4];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, fillcolor="#0069B4", fontcolor="white", width=1.05];
  edge [color="#1B2A4A", arrowsize=0.7];

  n1 [label="1. Requisitos"];
  n2 [label="2. Arquitectura"];
  n3 [label="3. Modelos & SQL"];
  n4 [label="4. Blueprints"];
  n5 [label="5. Generación\n& Monitor"];
  n6 [label="6. Código & Fix"];
  n7 [label="7. Calidad SAST"];
  n8 [label="8. DevOps"];
  n9 [label="9. Entrega", fillcolor="#E20074"];

  n1 -> n2 -> n3 -> n4 -> n5 -> n6 -> n7 -> n8 -> n9;
}
