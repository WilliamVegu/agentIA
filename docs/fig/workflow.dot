digraph workflow {
  rankdir=LR; fontname="Helvetica"; newrank=true;
  graph [nodesep=0.5, ranksep=0.9, margin=0.1];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=15];
  edge [fontname="Helvetica", fontsize=11, color="#5a6b7b"];

  START [shape=circle, fillcolor="#eaf2ea", label="INICIO", fontsize=14];
  END   [shape=doublecircle, fillcolor="#fbe9e7", label="FIN", fontsize=14];

  validator  [fillcolor="#f4f7fa", label="validador\n(compuerta del blueprint)"];
  scaffolder [fillcolor="#f4f7fa"];
  domain     [fillcolor="#f4f7fa", label="dominio\n(entidades, DTOs)"];
  service    [fillcolor="#f4f7fa", label="servicio\n(lógica)"];
  controller [fillcolor="#f4f7fa", label="controlador\n(REST)"];
  test       [fillcolor="#f4f7fa", label="test\n(Mockito)"];
  sandbox    [fillcolor="#fdf0e6", label="sandbox\ncompila + prueba"];
  repair     [fillcolor="#fff3e0", label="reparación\n(≤3 intentos, parche quirúrgico)"];

  START -> validator;
  validator -> scaffolder [label="ok"];
  validator -> END [label="FALLIDO", color="#c0392b"];
  scaffolder -> domain -> service -> controller -> test;
  test -> sandbox;
  sandbox -> END [label="compiló", color="#27ae60"];
  sandbox -> repair [label="falló", color="#c0392b"];
  sandbox -> END [label="BLOQUEADO", color="#c0392b"];
  repair -> sandbox [label="reintento"];
  repair -> END [label="BLOQUEADO\n(máx. intentos)", color="#c0392b"];
}
