digraph G {
  rankdir=TB; fontname="Helvetica"; newrank=true; compound=true;
  graph [nodesep=0.4, ranksep=0.55];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, fillcolor="#ffffff", color="#5a6b7b", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=11, color="#5a6b7b"];

  subgraph cluster_fe {
    label="Frontend (React)"; style=filled; fillcolor="#EAF2FA"; fontsize=15; color="#0076CE"; penwidth=2;
    spec [label="SpecIngestion\nblueprint + interfaz\n(volumen, datos, integraciones)", fillcolor="#ffffff"];
    prev [label="ArchitecturePreview\nperfil + plan inferido", fillcolor="#ffffff"];
    mon  [label="GenerationMonitor\nlogs en vivo (SSE)", fillcolor="#ffffff"];
    sett [label="SettingsDrawer\nLLM + secretos externos", fillcolor="#ffffff"];
  }

  subgraph cluster_be {
    label="Backend — Orquestación (LangGraph)"; style=filled; fillcolor="#EAF2EA"; fontsize=15; color="#0F172A"; penwidth=2;
    inf [label="InferenceEngine\nspec → ArchitecturePlan", fillcolor="#FFF3E0"];
    scf [label="Scaffolder (determinista)\narquetipo / quarkus create\n(cero tokens)", fillcolor="#FFF3E0"];
    gen [label="Generación LLM\ndomain · service\ncontroller · test", fillcolor="#ffffff"];
    gate[label="ComplianceGate\nreglas · nombres ·\nsin secretos en código", fillcolor="#ffffff"];
    ver [label="VerificationSandbox\nbuild hermético\nmulti-módulo", fillcolor="#ffffff"];
    inf -> scf [label="plan"];
    scf -> gen [label="módulos creados"];
    gen -> gate;
    gate -> ver;
  }

  subgraph cluster_cat {
    label="Catálogo e Infraestructura"; style=filled; fillcolor="#F2F0F4"; fontsize=15; color="#E20074"; penwidth=2;
    cat [label="ArchitectureCatalog\nperfiles: layered · hexagonal ·\nhexagonal-ddd + arquetipos", fillcolor="#ffffff"];
    qcli[label="Quarkus CLI\n(quarkus create)", fillcolor="#ffffff"];
    arch[label="Arquetipos Maven\n(por perfil)", fillcolor="#ffffff"];
    dck [label="Docker sandbox\n+ caché .m2", fillcolor="#ffffff"];
    cost[label="Cost store + MLflow", fillcolor="#ffffff"];
  }

  spec -> inf [label="spec formal"];
  prev -> inf [style=dashed, label="muestra"];
  inf -> cat [label="elige perfil"];
  cat -> scf [label="arquetipo / plantilla"];
  qcli -> scf [label="genera carpetas"];
  dck -> ver [label="compila offline"];
  sett -> gen [label="clave / modelo"];
  mon -> gen [style=dashed, label="observa"];
  gen -> cost [style=dotted, label="coste/tokens"];
  ver -> cost [style=dotted];

  // output
  out [label="Entrega\nZIP / Git", fillcolor="#E8F5E9"];
  ver -> out [label="pasa"];
}
