# ==============================================================================
# Microservice Code Studio - Local Environment Configuration
# ==============================================================================

# LLM Providers Configuration (Optional for offline mock mode, or enter via web UI)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recomendado - Free Tier en: https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud API Key (Opcional - Free Tier ultrarrápido en: https://console.groq.com/)
GROQ_API_KEY=

# OpenAI API Key (Opcional)
OPENAI_API_KEY=

# Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Acceso automático al MVP desde localhost. false exige usuario y contraseña.
STUDIO_AUTO_LOGIN=true
STUDIO_USER_EMAIL=
STUDIO_ACCESS_TOKEN=

# Concurrency & Execution Limits
# ------------------------------------------------------------------------------
MAX_CONCURRENT_SESSIONS=2
MAX_REPAIR_ATTEMPTS=3

# Storage & Database
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./studio.db

# Docker es opcional por sesión; el modo por defecto entrega fuentes sin ejecutarlo.
# Este interruptor permite/prohíbe Docker en el servidor, sin seleccionarlo para el usuario.
# Si se solicita Docker y no está disponible: Reintentar o Continuar sin Docker.
# ------------------------------------------------------------------------------
DOCKER_IMAGE=maven:3.9-eclipse-temurin-21
DOCKER_ENABLED=true
# Diagnóstico solicitado: timeout de lectura de caché (1–60 s) y mínimo libre host.
LOCAL_DIAGNOSTIC_CACHE_TIMEOUT=15
LOCAL_MIN_FREE_BYTES=536870912

