# ==============================================================================
# Microservice Code Studio - Local Environment Configuration
# ==============================================================================

# LLM Providers Configuration (Optional for offline mock mode, or enter via web UI)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recomendado - Free Tier en: https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq Cloud API Key (Opcional - Free Tier ultrarrápido en: https://console.groq.com/)
GROQ_API_KEY=

# OpenAI API Key (Opcional)
OPENAI_API_KEY=

# Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Concurrency & Execution Limits
# ------------------------------------------------------------------------------
MAX_CONCURRENT_SESSIONS=2
MAX_REPAIR_ATTEMPTS=3

# Storage & Database
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./studio.db

# Docker Sandbox (Opcional: Si Docker no está activo, opera en modo hermético simulado)
# ------------------------------------------------------------------------------
DOCKER_IMAGE=maven:3.9-eclipse-temurin-21

