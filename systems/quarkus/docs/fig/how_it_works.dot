digraph how {
  rankdir=LR; fontname="Helvetica"; newrank=true;
  graph [nodesep=0.5, ranksep=0.5];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=16];
  edge [fontname="Helvetica", fontsize=13, color="#5a6b7b"];

  spec [fillcolor="#eef3f8", label="Especificación\n(blueprint: entidades,\nreglas, historias BDD)"];
  agent [fillcolor="#eaf2ea", label="Agente autónomo\nescribe el servicio\n(5 etapas)"];
  check [fillcolor="#fdf0e6", label="Verificación hermética\ncompila + prueba\n(sin red, contenedor sellado)"];
  out  [fillcolor="#e8f5e9", label="Microservicio\nlisto (ZIP / Git)"];

  spec -> agent;
  agent -> check;
  check -> out [label=" pasa"];
  check -> agent [label=" falla → corrige (máx. 3×)", color="#c0392b"];
  check -> agent [label=" 3er fallo → BLOQUEADO (humano)", color="#c0392b", style=dashed];
}
